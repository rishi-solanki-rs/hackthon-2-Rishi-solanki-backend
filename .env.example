# Sidekit Backend Configuration
PORT=4000

# Server-Side Gemini API Key (keep this private, never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Enable/disable server-side AI task interpretation
GEMINI_ENABLED=true

# Gemini model and per-request timeout. Slow models fall back to deterministic templates on timeout.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=12000

# Daily request cap for cost control
GEMINI_DAILY_CAP=500

# Optional MongoDB connection (if omitted, server runs resiliently with in-memory store)
MONGODB_URI=mongodb://localhost:27017/sidekit

# Comma-separated browser origins allowed by CORS (the deployed frontend URL)
CLIENT_URL=http://localhost:5173
